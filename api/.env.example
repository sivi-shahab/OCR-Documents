# All settings are optional; defaults are shown.
OCR_VLLM_BASE_URL=http://localhost:8100/v1
OCR_VLLM_API_KEY=EMPTY
OCR_MODEL_NAME=Unlimited-OCR
OCR_REQUEST_TIMEOUT_SECONDS=1200
OCR_MAX_TOKENS=8192
OCR_NGRAM_SIZE=35
OCR_SINGLE_IMAGE_WINDOW=128
OCR_MULTI_IMAGE_WINDOW=1024
OCR_MAX_UPLOAD_MB=50
OCR_MAX_PDF_PAGES=200
OCR_PDF_DPI=200
OCR_PAGE_CONCURRENCY=8
OCR_JOB_DIR=data/jobs
OCR_JOB_MAX_UPLOAD_MB=500
OCR_JOB_MAX_PDF_PAGES=2000
OCR_JOB_MAX_RUNNING=2
OCR_JOB_PAGE_CONCURRENCY=32
OCR_JOB_PAGE_ATTEMPTS=3
OCR_JOB_RETRY_BACKOFF_SECONDS=2
OCR_JOB_FIRST_PASS_MAX_TOKENS=6144
OCR_JOB_RETRY_TEMPERATURE_STEP=0.2
OCR_JOB_ESCALATION_DPI=300
OCR_JOB_MAX_FALLBACK_RATIO=0.004
OCR_WEBHOOK_SECRET=
OCR_WEBHOOK_ALLOWED_HOSTS=

# Azure AI Document Intelligence for /v1/ocr/azure (disabled until endpoint and key are set)
OCR_AZURE_DI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
OCR_AZURE_DI_API_KEY=
OCR_AZURE_DI_MODEL_ID=prebuilt-layout
OCR_AZURE_DI_API_VERSION=2024-11-30
OCR_AZURE_DI_TIMEOUT_SECONDS=600
